# This file is documentation only; Tomota does not automatically load it.
# Set only the variables you need in the shell before starting Studio.

# Optional: explicit Antigravity CLI executable.
TOMOTA_AGY_EXECUTABLE=C:\path\to\agy.exe

# Optional: explicit Chrome/Edge executable for the visible Fanqie browser.
TOMOTA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional local ports.
TOMOTA_STUDIO_PORT=43127
TOMOTA_STUDIO_API_PORT=43128

# Optional installed writing-skill locations.
TOMOTA_STORY_SKILL_ROOT=C:\Users\YOUR_NAME\.codex\skills\oh-story-claudecode
TOMOTA_WEBNOVEL_SKILL_ROOT=C:\Users\YOUR_NAME\.codex\skills\webnovel-writing
